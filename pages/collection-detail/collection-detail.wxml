<!-- pages/collection-detail/collection-detail.wxml -->
<view class="container" style="padding-top: calc(20rpx + {{statusBarHeight}}px)">
  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack">
    <text class="back-text">‹ 返回</text>
  </view>

  <!-- 标题：被收藏的字 + 收藏时间戳 -->
  <view class="page-header">
    <text class="page-title">{{word}}</text>
    <view class="page-subtitle-row">
      <text class="page-subtitle">收藏内容</text>
      <view class="subtitle-divider"></view>
      <text wx:if="{{collectedAtShort}}" class="collected-at">{{collectedAtShort}}</text>
    </view>
  </view>

  <!-- 结果区 -->
  <view class="result-area">
    <!-- 状态标签：流式中 -->
    <view wx:if="{{isShowingNew}}" class="result-label streaming">
      <text class="result-label-dot"></text>
      <text>正在生成新结果…</text>
    </view>
    <view wx:else class="result-label">
      <text class="result-label-dot static"></text>
      <text>{{isRegenerating ? '查询中…' : '已收藏的释义'}}</text>
    </view>

    <!-- 结构化渲染：读音 + 义项卡片（与查词页一致） -->
    <block wx:if="{{displayParsed && displayParsed.meanings.length > 0}}">
      <view wx:if="{{displayParsed.pinyin}}" class="result-pinyin">
        <text class="pinyin-text">{{displayParsed.pinyin}}</text>
      </view>
      <view class="definitions-list">
        <view class="definition-item" wx:for="{{displayParsed.meanings}}" wx:key="id" wx:for-item="m">
          <view class="definition-label-row">
            <text class="definition-label">{{index + 1}}.</text>
            <view class="definition-meaning">
              <text wx:if="{{m.pos}}" class="definition-pos">[{{m.pos}}]</text>
              <text>{{m.meaning}}</text>
            </view>
          </view>
          <view wx:if="{{m.example}}" class="examples-section">
            <view class="example-item">
              <text class="example-sentence">{{m.example}}</text>
              <text wx:if="{{m.source}}" class="example-source">（{{m.source}}）</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- fallback：AI 输出不符合结构化模板时用 markdownToHtml -->
    <block wx:else>
      <rich-text nodes="{{isShowingNew ? streamingHtml : originalHtml}}"></rich-text>
    </block>
  </view>

  <!-- 底部按钮组 -->
  <view class="action-btns">
    <button class="btn-secondary" bindtap="copyContent" disabled="{{!originalResult && !streamingText}}">复制</button>
    <button class="btn-tertiary" bindtap="removeCollect">取消收藏</button>
    <button class="btn-primary" bindtap="regenerate" disabled="{{isRegenerating}}">{{isRegenerating ? '查询中...' : '重新生成'}}</button>
  </view>
</view>
