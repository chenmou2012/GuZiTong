/* pages/review/review.wxss */
/* UI 全面对齐 pages/learn/learn.wxss 的多选题样式（颜色、字号、间距、按钮组） */

.container {
  min-height: 100vh;
  background-color: #FDFBF7;
}

/* 重置原生 button 默认样式（避免粗细不一致） */
button {
  margin: 0;
  padding: 0;
  line-height: 1.4;
  font-size: inherit;
  font-weight: inherit;
  background: transparent;
  border-radius: 0;
  box-sizing: border-box;
}
button::after {
  border: none;
}

/* 顶部退出按钮 */
.exit-btn {
  position: fixed;
  top: 30rpx;
  left: 30rpx;
  z-index: 100;
  padding: 12rpx 24rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 30rpx;
}

.exit-btn:active {
  background: rgba(0, 0, 0, 0.1);
}

.exit-btn-text {
  font-size: 26rpx;
  color: #666;
}

.review-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  padding-top: 100rpx; /* 给顶部退出按钮留位 */
}

/* ==================== 进度条 ==================== */
.progress-bar {
  width: 100%;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #bc262e;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 48rpx;
}

/* ==================== 题目卡片 ==================== */
.quiz-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.main-card {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 64rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  justify-content: center;
  align-items: center;
}

.word {
  font-size: 72rpx;
  font-weight: bold;
  color: #2C3E50;
}

/* ==================== 问题提示（与 learn.wxss .question-text 同构）==================== */
.question-text {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 16rpx 0 24rpx;
}

/* 多选题正确答案数提示 */
.multi-hint {
  text-align: center;
  font-size: 26rpx;
  color: #888;
  padding: 0 0 16rpx;
}

/* ==================== 选项（与 learn.wxss .option-btn 系列完全一致）==================== */
.options-area {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
  width: 100%;
}

.option-btn {
  padding: 28rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  text-align: center;
  color: #2C3E50;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.option-btn:active {
  background: #fafafa;
}

.option-btn.correct {
  background: #E8F5E9 !important;
  color: #2E7D32 !important;
}

.option-btn.wrong {
  background: #FFEBEE !important;
  color: #C62828 !important;
}

.option-btn.selected {
  background: #E3F2FD !important;
  color: #1565C0 !important;
}

/* ==================== 结果区（与 learn.wxss 同构）==================== */
.result-area {
  text-align: center;
  padding: 24rpx 0;
  width: 100%;
}

.result-correct {
  color: #2E7D32;
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.result-wrong {
  color: #C62828;
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.correct-answers {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #fafafa;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  text-align: left;
  line-height: 1.8;
}

/* ==================== 底部按钮组（与 learn.wxss 同构）==================== */
.result-btns {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 30rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FDFBF7;
  z-index: 100;
  box-sizing: border-box;
}

.answer-btn {
  flex: 1;
  padding: 24rpx 0;
  background: #fff;
  color: #666;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid #e0e0e0;
}

.answer-btn:active {
  background: #fafafa;
}

.answer-btn.disabled {
  color: #bbb;
  border-color: #f0f0f0;
}

.next-btn {
  flex: 1;
  padding: 24rpx 0;
  background: #bc262e;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.next-btn:active {
  background: #991b1b;
}

.next-btn.disabled {
  background: #e0e0e0;
  color: #999;
}

/* ==================== self 模式（防御性，理论不触发）==================== */
.meaning-area {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.meaning-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meaning-item {
  display: flex;
  font-size: 32rpx;
  color: #2C3E50;
  line-height: 1.6;
}

.meaning-number {
  color: #bc262e;
  font-weight: bold;
  margin-right: 8rpx;
}

.meaning-text {
  flex: 1;
}

.btns {
  display: flex;
  gap: 24rpx;
  width: 100%;
  padding: 24rpx 30rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FDFBF7;
  z-index: 100;
  box-sizing: border-box;
}

.btns button {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 1.4;
}

/* 三档按钮（self 模式，防御性保留） */
.btn-hard {
  background: #f5f5f5;
  color: #666;
}

.btn-hard-confirm {
  background: #f5f5f5;
  color: #666;
}

.btn-good {
  background: #fff;
  color: #bc262e;
  border: 2rpx solid #bc262e;
}

.btn-easy {
  background: #bc262e;
  color: #fff;
}

/* ==================== 完成态 ==================== */
.done-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  min-height: 60vh;
}

.done-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #bc262e;
  margin-bottom: 16rpx;
}

.done-subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.redo-info {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 64rpx;
}

.btn-home {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: #bc262e;
  color: #fff;
  border: none;
}