<!-- pages/translations/translations.wxml -->
<view class="container" style="padding-top: calc(20rpx + {{statusBarHeight}}px)">
  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack">
    <text class="back-text">‹ 返回</text>
  </view>

  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">翻译历史</text>
  </view>

  <records-list
    list="{{translations}}"
    title-field="original"
    subtitle-field="translated"
    extra-field="fromCache"
    action-label="重译"
    action-event="action"
    empty-text="还没有翻译过文言文"
    bind:itemtap="onItemTap"
    bind:action="onItemAction"
    bind:itemdelete="onItemDelete"
    bind:clearall="onClearAll"
  />
</view>