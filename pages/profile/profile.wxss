/* 页面整体样式 */
.container {
  min-height: 100vh;
  background-color: #FDFBF7;
  padding: 20rpx 30rpx 120rpx;
  box-sizing: border-box;
}

/* 用户信息头部 */
.profile-header {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.avatar-section {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #B91C1C, #991b1b);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 24rpx;
}

.avatar-text {
  font-size: 44rpx;
  color: #fff;
  font-weight: 500;
  font-family: 'STSong', 'SimSun', serif;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.username {
  font-size: 36rpx;
  color: #2C3E50;
  font-weight: bold;
}

.user-level {
  font-size: 22rpx;
  color: #B91C1C;
  padding: 4rpx 16rpx;
  background-color: #fef2f2;
  border-radius: 20rpx;
  width: fit-content;
}

.avatar-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

/* 昵称行：横向排布「昵称 + 编辑提示」，整行可点击进入编辑 */
.nickname-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.nickname-row:active {
  opacity: 0.55;
}

.edit-arrow {
  font-size: 32rpx;
  color: #ccc;
  font-weight: 300;
  line-height: 1;
  margin-top: -6rpx;
}

/* 昵称编辑态：输入框 */
.nickname-edit-row {
  width: 360rpx;
}

.nickname-input {
  width: 100%;
  font-size: 32rpx;
  color: #2C3E50;
  border-bottom: 2rpx solid #B91C1C;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.nickname-edit-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.edit-btn {
  font-size: 26rpx;
  padding: 6rpx 22rpx;
  border-radius: 8rpx;
  line-height: 1.6;
}

.edit-btn-cancel {
  background-color: #f5f5f5;
  color: #666;
}

.edit-btn-save {
  background-color: #B91C1C;
  color: #fff;
}

.edit-btn-cancel:active {
  background-color: #e8e8e8;
}

.edit-btn-save:active {
  background-color: #991b1b;
}

.user-level-hint {
  background-color: #f5f5f5;
  color: #999;
}

/* 统计数据 */
.stats-section {
  display: flex;
  justify-content: space-around;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 40rpx;
  color: #2C3E50;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
}

/* 功能列表 */
.menu-section {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #fafafa;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-text {
  font-size: 30rpx;
  color: #2C3E50;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-count {
  font-size: 26rpx;
  color: #999;
  margin-right: 12rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
  font-weight: 300;
}

.version-inline {
  font-size: 24rpx;
  color: #bbb;
  margin-right: 12rpx;
}

/* 版本信息 */
.version-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.version-text {
  font-size: 24rpx;
  color: #bbb;
}

/* 学习统计卡片 */
.stats-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stats-card-header {
  margin-bottom: 20rpx;
}

.stats-card-title {
  font-size: 32rpx;
  color: #2C3E50;
  font-weight: bold;
}

.stats-card-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-item-number {
  font-size: 40rpx;
  color: #bc262e;
  font-weight: bold;
}

.stats-item-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

/* 饼图样式 */
.chart-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.chart-header {
  margin-bottom: 20rpx;
}

.chart-title {
  font-size: 32rpx;
  color: #2C3E50;
  font-weight: bold;
}

.chart-content {
  display: flex;
  align-items: center;
  gap: 40rpx;
}

.pie-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}

.chart-legend {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex: 1;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.legend-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

/* 设置弹窗 */
.settings-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.settings-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.settings-content {
  position: relative;
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.settings-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.settings-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.settings-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  padding: 0 8rpx;
}

.settings-body {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 80rpx;
}

.settings-label {
  font-size: 30rpx;
  color: #333;
}

.settings-label-danger {
  color: #B91C1C;
}

.settings-options {
  display: flex;
  gap: 16rpx;
}

.settings-option {
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
}

.settings-option.active {
  background: #B91C1C;
  color: #fff;
}

.settings-action-btn {
  background: #B91C1C !important;
  color: #fff !important;
  font-size: 26rpx !important;
  padding: 8rpx 24rpx !important;
  border-radius: 8rpx !important;
  border: none !important;
  line-height: 1.6 !important;
}

.settings-arrow {
  font-size: 32rpx;
  color: #ccc;
}