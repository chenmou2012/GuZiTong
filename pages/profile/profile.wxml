<!-- pages/profile/profile.wxml -->
<view class="container" style="padding-top: calc(20rpx + {{statusBarHeight}}px)">
  <!-- 用户信息头部 -->
  <view class="profile-header">
    <view class="avatar-section" bindtap="onAvatarTap">
      <view class="avatar">
        <text class="avatar-text">古</text>
      </view>

      <!-- 未登录：昵称文本直接触发登录（catchtap 阻止冒泡到外层 onAvatarTap） -->
      <view wx:if="{{!loggedIn}}" class="user-info" catchtap="onAvatarTap">
        <text class="username">{{displayNickname}}</text>
        <text class="user-level user-level-hint">未登录</text>
      </view>

      <!-- 已登录 + 查看态：昵称 + 细线箭头提示可点，整行可点进入编辑 -->
      <view wx:elif="{{!editingNickname}}" class="user-info">
        <view class="nickname-row" catchtap="onNicknameEdit">
          <text class="username">{{displayNickname}}</text>
          <text class="edit-arrow">›</text>
        </view>
      </view>

      <!-- 已登录 + 编辑态：输入框 + 保存/取消 -->
      <view wx:else class="user-info">
        <view class="nickname-edit-row">
          <input
            class="nickname-input"
            value="{{nicknameDraft}}"
            maxlength="16"
            focus="{{editingNickname}}"
            placeholder="请输入昵称"
            bindinput="onNicknameInput"
          />
        </view>
        <view class="nickname-edit-btns">
          <text class="edit-btn edit-btn-cancel" catchtap="onNicknameCancel">取消</text>
          <text class="edit-btn edit-btn-save" catchtap="onNicknameSave">保存</text>
        </view>
      </view>
    </view>

    <view class="stats-section">
      <view class="stat-item">
        <text class="stat-number">{{stats.words}}</text>
        <text class="stat-label">查词</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{stats.collections}}</text>
        <text class="stat-label">收藏</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{stats.translations}}</text>
        <text class="stat-label">翻译</text>
      </view>
    </view>
  </view>

  <!-- 学习统计卡片 -->
  <view class="stats-card">
    <view class="stats-card-header">
      <text class="stats-card-title">学习统计</text>
    </view>
    <view class="stats-card-content">
      <view class="stats-row">
        <view class="stats-item">
          <text class="stats-item-number">{{reviewStats.todayLearn}}</text>
          <text class="stats-item-label">今日学习</text>
        </view>
        <view class="stats-item">
          <text class="stats-item-number">{{reviewStats.todayReview}}</text>
          <text class="stats-item-label">今日复习</text>
        </view>
        <view class="stats-item">
          <text class="stats-item-number">{{reviewStats.streakDays}}</text>
          <text class="stats-item-label">连续（天）</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 学习进度饼图 -->
  <view class="chart-card">
    <view class="chart-header">
      <text class="chart-title">学习进度</text>
    </view>
    <view class="chart-content">
      <view class="pie-circle" style="background: conic-gradient(#d0d0d0 0deg {{pieChart.unlearnedPercent}}deg, #f5ad1e {{pieChart.unlearnedPercent}}deg {{pieChart.unlearnedPercent + pieChart.reviewingPercent}}deg, #4CAF50 {{pieChart.unlearnedPercent + pieChart.reviewingPercent}}deg 360deg);"></view>
      <view class="chart-legend">
        <view class="legend-item">
          <view class="legend-color" style="background:#d0d0d0"></view>
          <text>未学习 {{pieChart.unlearned}}</text>
        </view>
        <view class="legend-item">
          <view class="legend-color" style="background:#f5ad1e"></view>
          <text>复习中 {{pieChart.reviewing}}</text>
        </view>
        <view class="legend-item">
          <view class="legend-color" style="background:#4CAF50"></view>
          <text>已掌握 {{pieChart.reviewed}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goHistory">
      <view class="menu-left">
        <text class="menu-text">学习记录</text>
      </view>
      <view class="menu-right">
        <text class="menu-count">{{stats.words}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-item" bindtap="goCollections">
      <view class="menu-left">
        <text class="menu-text">我的收藏</text>
      </view>
      <view class="menu-right">
        <text class="menu-count">{{stats.collections}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-item" bindtap="goTranslations">
      <view class="menu-left">
        <text class="menu-text">翻译历史</text>
      </view>
      <view class="menu-right">
        <text class="menu-count">{{stats.translations}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="showSettings">
      <view class="menu-left">
        <text class="menu-text">学习设置</text>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-item" bindtap="goFeedback">
      <view class="menu-left">
        <text class="menu-text">意见反馈</text>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-item" bindtap="viewAbout">
      <view class="menu-left">
        <text class="menu-text">关于古字通</text>
      </view>
      <view class="menu-right">
        <text class="version-inline">v1.0.0</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-section">
    <text class="version-text">© 古字通 · 让文言文学习更简单</text>
  </view>

  <!-- 设置弹窗 -->
  <view class="settings-modal" wx:if="{{showSettingsModal}}">
    <view class="settings-overlay" bindtap="hideSettings"></view>
    <view class="settings-content">
      <view class="settings-header">
        <text class="settings-title">学习设置</text>
        <text class="settings-close" bindtap="hideSettings">×</text>
      </view>
      <view class="settings-body">
        <view class="settings-item">
          <text class="settings-label">每组字数</text>
          <view class="settings-options">
            <text class="settings-option {{settings.groupSize === 3 ? 'active' : ''}}" bindtap="changeGroupSize" data-size="3">3</text>
            <text class="settings-option {{settings.groupSize === 5 ? 'active' : ''}}" bindtap="changeGroupSize" data-size="5">5</text>
            <text class="settings-option {{settings.groupSize === 10 ? 'active' : ''}}" bindtap="changeGroupSize" data-size="10">10</text>
          </view>
        </view>

        <view class="settings-item" wx:if="{{loggedIn}}">
          <text class="settings-label">数据同步</text>
          <button class="settings-action-btn" bindtap="syncData">立即同步</button>
        </view>

        <view class="settings-item" wx:if="{{loggedIn}}" bindtap="doLogout">
          <text class="settings-label settings-label-danger">退出登录</text>
          <text class="settings-arrow">›</text>
        </view>
      </view>
    </view>
  </view>
</view>