/* pages/history/history.wxss */
.container {
  min-height: 100vh;
  background-color: #FDFBF7;
  padding: 20rpx 30rpx 120rpx;
  box-sizing: border-box;
}

.back-btn {
  position: fixed;
  top: calc(20rpx + {{statusBarHeight}}px);
  left: 20rpx;
  z-index: 100;
}

.back-text {
  font-size: 28rpx;
  color: #B91C1C;
}

.page-header {
  padding: 24rpx 0 30rpx;
  text-align: center;
}

.page-title {
  font-size: 36rpx;
  color: #2C3E50;
  font-weight: bold;
}