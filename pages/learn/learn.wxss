/* pages/learn/learn.wxss */
/* 与全局视觉统一：米白背景 + 白色卡片 + 学术红 + 宋体（参见 app.wxss） */

/* 重置原生 button 默认样式，避免粗细不一致 */
button {
  margin: 0;
  padding: 0;
  line-height: 1.4;
  font-size: inherit;
  font-weight: inherit;
  background: transparent;
  border-radius: 0;
  box-sizing: border-box;
}
button::after {
  border: none;
}

/* ============ 主界面（非学习态） ============ */

.container {
  min-height: 100vh;
  background-color: #FDFBF7;
  padding: 0 30rpx 120rpx;
  box-sizing: border-box;
}

/* 标题 */
.main-header {
  padding: 80rpx 0 40rpx;
  text-align: center;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #bc262e;
  letter-spacing: 8rpx;
}

.content-area {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* 进度卡片 */
.progress-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.progress-card-inner {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.progress-card-left {
  flex: 1;
}

.progress-card-status-area {
  margin-bottom: 12rpx;
}

.progress-card-status {
  font-size: 24rpx;
  color: #888;
  letter-spacing: 2rpx;
}

.progress-card-title-area {
  margin-bottom: 16rpx;
}

.progress-card-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2C3E50;
}

.progress-card-info-area {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.progress-card-current,
.progress-card-chapter {
  font-size: 28rpx;
  color: #666;
}

.divider {
  margin: 0 16rpx;
  color: #ccc;
}

.current-word,
.chapter-count {
  color: #2C3E50;
  font-weight: 500;
}

/* 右侧进度 */
.progress-card-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-left: 24rpx;
}

.progress-card-right .progress-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #bc262e;
  line-height: 1;
}

.progress-card-right .progress-label {
  font-size: 22rpx;
  color: #888;
  margin-top: 8rpx;
}

/* 卡片底部 */
.progress-card-footer {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-quote {
  font-size: 24rpx;
  color: #888;
  font-style: italic;
}

.footer-remaining {
  font-size: 24rpx;
  font-weight: 600;
  color: #bc262e;
}

/* 提示条 */
.session-info {
  text-align: center;
  padding: 8rpx 0;
}

.session-tip {
  font-size: 26rpx;
  color: #888;
}

/* 主操作按钮 */
.action-buttons {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  padding: 32rpx 0;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  transition: all 0.2s ease;
}

.action-btn.start-btn {
  background: #bc262e;
  color: #fff;
}

.action-btn.start-btn:active {
  background: #991b1b;
  transform: scale(0.98);
}

.action-btn.review-btn {
  background: #fff;
  color: #bc262e;
  border: 2rpx solid #bc262e;
}

.action-btn.review-btn:active {
  background: #fef2f2;
  transform: scale(0.98);
}

.action-btn-text {
  font-size: inherit;
  font-weight: inherit;
  letter-spacing: inherit;
}

/* 字音跟读入口 */
.pronounce-entry {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.pronounce-entry:active {
  background: #fafafa;
}

.pronounce-entry-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.pronounce-entry-text {
  flex: 1;
  font-size: 30rpx;
  color: #2C3E50;
}

.pronounce-entry-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* ============ 学习态：退出按钮 ============ */

.exit-btn {
  position: fixed;
  top: 30rpx;
  left: 30rpx;
  z-index: 100;
  padding: 12rpx 24rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 30rpx;
}

.exit-btn:active {
  background: rgba(0, 0, 0, 0.1);
}

.exit-btn-text {
  font-size: 26rpx;
  color: #666;
}

/* ============ 学习态：展示环节（intro） ============ */

.intro-phase {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 30rpx 40rpx;
}

.phase-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2C3E50;
  margin-bottom: 16rpx;
  text-align: center;
}

.group-progress {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 40rpx;
}

.intro-word-item {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 40rpx;
}

.intro-word {
  display: block;
  font-size: 96rpx;
  font-weight: bold;
  color: #bc262e;
  text-align: center;
  letter-spacing: 8rpx;
  margin-bottom: 40rpx;
}

.intro-meanings-list {
  width: 100%;
}

.intro-meaning-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 28rpx;
  margin-bottom: 16rpx;
  background: #faf8f5;
  border-radius: 12rpx;
  border-left: 6rpx solid #bc262e;
}

.intro-meaning-item:last-child {
  margin-bottom: 0;
}

.meaning-number {
  font-size: 28rpx;
  color: #bc262e;
  font-weight: bold;
  margin-right: 16rpx;
  min-width: 40rpx;
}

.meaning-text {
  flex: 1;
  font-size: 32rpx;
  color: #2C3E50;
  line-height: 1.7;
}

.intro-btns {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.btn-prev,
.btn-next {
  padding: 20rpx 56rpx;
  background: #fff;
  color: #2C3E50;
  border-radius: 24rpx;
  font-size: 28rpx;
  border: 2rpx solid #e0e0e0;
  font-weight: 600;
}

.btn-prev:active,
.btn-next:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.btn-next {
  background: #bc262e;
  color: #fff;
  border-color: #bc262e;
}

/* ============ 学习态：练习环节（practice） ============ */

.practice-phase {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 30rpx;
}

/* 顶部进度条 */
.header-progress-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  z-index: 100;
}

.header-progress-bg {
  height: 4rpx;
  background: #f0f0f0;
  width: 100%;
}

.header-progress-fill {
  height: 4rpx;
  background: #bc262e;
  transition: width 0.3s ease;
}

/* 练习页头部 */
.header-info {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  width: 100%;
  padding: 100rpx 0 24rpx;
}

.progress-info {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #bc262e;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.progress-label {
  font-size: 22rpx;
  color: #888;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.header-info .progress-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-top: 4rpx;
}

.group-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.group-label {
  font-size: 24rpx;
  color: #888;
}

/* 题目卡片 */
.quiz-area {
  width: 100%;
  flex-shrink: 0;
}

.main-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.quote-text {
  font-size: 38rpx;
  color: #2C3E50;
  line-height: 1.8;
}

.quote-source {
  display: block;
  font-size: 24rpx;
  color: #888;
  text-align: right;
  margin-top: 16rpx;
}

.question-text {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 16rpx 0 24rpx;
}

.bold-word {
  font-weight: bold;
  color: #bc262e;
}

/* 选项 */
.options-area {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.option-btn {
  padding: 28rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  text-align: center;
  color: #2C3E50;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.option-btn:active {
  background: #fafafa;
}

.option-btn.correct {
  background: #E8F5E9 !important;
  color: #2E7D32 !important;
}

.option-btn.wrong {
  background: #FFEBEE !important;
  color: #C62828 !important;
}

.option-btn.selected {
  background: #E3F2FD !important;
  color: #1565C0 !important;
}

/* 结果提示 */
.result-area {
  text-align: center;
  padding: 24rpx 0;
}

.result-correct {
  color: #2E7D32;
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.result-wrong {
  color: #C62828;
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.correct-answers {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #fafafa;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  text-align: left;
  line-height: 1.8;
}

/* 底部结果按钮组 */
.result-btns {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 30rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FDFBF7;
  z-index: 100;
  box-sizing: border-box;
}

.answer-btn {
  flex: 1;
  padding: 24rpx 0;
  background: #fff;
  color: #666;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid #e0e0e0;
}

.answer-btn:active {
  background: #fafafa;
}

.next-btn {
  flex: 1;
  padding: 24rpx 0;
  background: #bc262e;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.next-btn:active {
  background: #991b1b;
}

.next-btn.disabled {
  background: #e0e0e0;
  color: #999;
}