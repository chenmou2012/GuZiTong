<!-- pages/learn/learn.wxml -->
<view class="container" style="padding-top: {{statusBarHeight}}px">
  <!-- BEGIN: MainHeader -->
  <view wx:if="{{!learning}}" class="main-header">
    <view class="header-title">文言文学习</view>
  </view>
  <!-- END: MainHeader -->

  <!-- BEGIN: ContentArea -->
  <view wx:if="{{!learning}}" class="content-area">
    <!-- BEGIN: ProgressCard -->
    <view class="progress-card">
      <view class="progress-card-inner">
        <view class="progress-card-left">
          <view class="progress-card-status-area">
            <text class="progress-card-status">正在学习</text>
          </view>
          <view class="progress-card-title-area">
            <text class="progress-card-title">《初中文言文字词》</text>
          </view>
          <view class="progress-card-info-area">
            <text class="progress-card-current">当前章节 <text class="divider">|</text> <text class="current-word">{{currentLearningWord}}</text></text>
            <text class="progress-card-chapter">本章进度 <text class="divider">|</text> <text class="chapter-count">{{learnedCount}} / {{totalCount}} 词</text></text>
          </view>
        </view>
        <!-- Progress Indicator -->
        <view class="progress-card-right">
          <text class="progress-text">{{learnProgress}}%</text>
          <text class="progress-label">总进度</text>
        </view>
      </view>
      <!-- Word Count Footer in Card -->
      <view class="progress-card-footer">
        <text class="footer-quote">学而不思则罔，思而不学则殆</text>
        <text class="footer-remaining">还剩 {{totalCount - learnedCount}} 词</text>
      </view>
    </view>
    <!-- END: ProgressCard -->

    <!-- BEGIN: SessionInfo -->
    <view class="session-info">
      <text class="session-tip">每组 {{groupSize}} 个词 · 先展示后练习</text>
    </view>
    <!-- END: SessionInfo -->

    <!-- BEGIN: ActionButtons -->
    <view class="action-buttons">
      <button class="action-btn start-btn" bindtap="startLearn">
        <text class="action-btn-text">开始学习</text>
      </button>
      <button class="action-btn review-btn" bindtap="startReview">
        <text class="action-btn-text">温故复习{{reviewCount > 0 ? '(' + reviewCount + ')' : ''}}</text>
      </button>
    </view>
    <!-- END: ActionButtons -->

    <!-- 字音跟读入口 -->
    <view class="pronounce-entry" bindtap="goPronounce">
      <text class="pronounce-entry-icon">🔊</text>
      <text class="pronounce-entry-text">字音跟读 · 150字正音</text>
      <text class="pronounce-entry-arrow">›</text>
    </view>
  </view>
  <!-- END: ContentArea -->

  <!-- 学习中 -->
  <view wx:else>
    <!-- 退出按钮 -->
    <view class="exit-btn" bindtap="exitLearn">
      <text class="exit-btn-text">✕ 退出</text>
    </view>

    <!-- 展示环节 -->
    <view wx:if="{{phase === 'intro'}}" class="intro-phase">
      <view class="group-progress">已学 {{learnedCount}}/{{totalCount}}</view>

      <!-- 当前展示的词 -->
      <view class="intro-word-item" wx:if="{{groupWords[introIndex]}}">
        <text class="intro-word">{{groupWords[introIndex].word}}</text>
        <view class="intro-meanings-list">
          <block wx:for="{{groupWords[introIndex].meanings}}" wx:for-item="m" wx:key="meaning">
            <view class="intro-meaning-item">
              <text class="meaning-number">{{index + 1}}.</text>
              <text class="meaning-text">{{m.meaning}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>

    <!-- 展示环节底部固定导航栏 -->
    <view wx:if="{{phase === 'intro'}}" class="intro-nav-bar">
      <button class="intro-nav-btn btn-prev" bindtap="prevIntro" wx:if="{{introIndex > 0}}">上一个</button>
      <button class="intro-nav-btn btn-next" bindtap="nextIntro" wx:if="{{introIndex < groupSize - 1}}">下一个</button>
      <button class="intro-nav-btn action-btn start-btn" bindtap="startPractice" wx:if="{{introIndex === groupSize - 1}}">
        <text class="action-btn-text">开始练习</text>
      </button>
    </view>

    <!-- 练习环节 -->
    <view wx:if="{{phase === 'practice'}}" class="practice-phase">
      <!-- 头部信息 -->
      <view class="header-info">
        <view class="progress-info">
          <text class="progress-label">词进度</text>
          <text class="progress-text">{{currentWordIndex + 1}}/{{groupSize}} · 第 {{quizIndex + 1}}/{{quizQueue.length}} 题</text>
        </view>
        <view class="group-info">
          <text class="group-label">已学 {{learnedCount}}/{{totalCount}}</text>
        </view>
      </view>

      <!-- 题目卡片 -->
      <view class="quiz-area">
        <!-- 题目 -->
        <view class="main-card">
          <view wx:if="{{quizType === 'sentence_meaning' && sentenceParts}}" class="quote-text">
            <text wx:for="{{sentenceParts}}" wx:key="key" wx:for-item="part" class="{{part.isBold ? 'bold-word' : ''}}">{{part.text}}</text>
          </view>
          <view wx:elif="{{quizType === 'sentence_meaning'}}" class="quote-text">{{quiz.sentence}}</view>
          <view wx:else class="quote-text">{{quiz.word}}</view>
          <!-- 来源 -->
          <text wx:if="{{quizType === 'sentence_meaning' && quiz.source}}" class="quote-source">（——{{quiz.source}}）</text>
        </view>

        <!-- 问题 -->
        <view class="question-text">
          <text wx:if="{{quizType === 'sentence_meaning'}}">选择加粗字的意思</text>
          <text wx:elif="{{quizType === 'select_meanings'}}">选出"{{quiz.word}}"所有的意思</text>
          <text wx:else>选择正确的释义</text>
        </view>

        <!-- 多选题正确答案数提示 -->
        <view wx:if="{{quizType === 'select_meanings' && correctCount > 0}}" class="multi-hint">
          <text>本题有 {{correctCount}} 个正确答案（已选 {{selectedIndexes.length}}）</text>
        </view>

        <!-- 选项 -->
        <view class="options-area">
          <block wx:if="{{quizType === 'select_meanings'}}">
            <view wx:for="{{optionDisplays}}" wx:key="idx" wx:for-item="opt" wx:for-index="idx"
                  class="option-btn {{showResult ? (opt.correct ? 'correct' : (opt.selected ? 'wrong' : '')) : (opt.selected ? 'selected' : '')}}"
                  bindtap="selectAnswer" data-index="{{idx}}">
              <text>{{opt.text}}{{showResult ? (opt.correct ? '  ✓' : (opt.selected ? '  ✗' : '')) : ''}}</text>
            </view>
          </block>
          <block wx:else>
            <view wx:for="{{optionDisplays}}" wx:key="idx" wx:for-item="opt" wx:for-index="idx"
                  class="option-btn {{showResult ? (opt.correct ? 'correct' : (selectedIndex == idx ? 'wrong' : '')) : (selectedIndex == idx ? 'selected' : '')}}"
                  bindtap="selectAnswer" data-index="{{idx}}">
              <text>{{opt.text}}{{showResult ? (opt.correct ? '  ✓' : (selectedIndex == idx ? '  ✗' : '')) : ''}}</text>
            </view>
          </block>
        </view>

        <!-- 结果 -->
        <view wx:if="{{showResult}}" class="result-area">
          <text wx:if="{{isCorrect}}" class="result-correct">✓ 回答正确！</text>
          <text wx:else class="result-wrong">✗ 回答错误</text>
        </view>

        <!-- 全部按钮：统一在 result-btns 中处理 -->
        <!-- 单选时：未选择时下一题灰色不可点 -->
        <view wx:if="{{quizType === 'sentence_meaning' && selectedIndex === -1}}" class="result-btns">
          <button class="answer-btn" bindtap="giveUp">看答案</button>
          <button class="next-btn disabled">下一题</button>
        </view>
        <!-- 单选时：已选择但未提交结果 -->
        <view wx:if="{{quizType === 'sentence_meaning' && selectedIndex !== -1 && !showResult}}" class="result-btns">
          <button class="answer-btn" bindtap="giveUp">看答案</button>
          <button class="next-btn" bindtap="nextQuestion">下一题</button>
        </view>
        <!-- 单选时：已提交显示灰色看答案 -->
        <view wx:if="{{quizType === 'sentence_meaning' && showResult}}" class="result-btns">
          <button class="answer-btn disabled">看答案</button>
          <button class="next-btn" bindtap="nextQuestion">下一题</button>
        </view>
        <!-- 多选时：未选择时 -->
        <view wx:if="{{quizType === 'select_meanings' && selectedIndexes.length === 0}}" class="result-btns">
          <button class="answer-btn" bindtap="giveUp">看答案</button>
          <button class="next-btn disabled">下一题</button>
        </view>
        <!-- 多选时：已选择(未提交或已提交) -->
        <view wx:if="{{quizType === 'select_meanings' && selectedIndexes.length > 0}}" class="result-btns">
          <button class="answer-btn disabled">看答案</button>
          <button class="next-btn" bindtap="nextQuestion">下一题</button>
        </view>
      </view>

      <!-- 底部进度条 -->
      <view class="header-progress-bar">
        <view class="header-progress-bg">
          <view class="header-progress-fill" style="width: {{(currentWordIndex * quizQueue.length + quizIndex + 1) / (groupSize * quizQueue.length) * 100}}%"></view>
        </view>
      </view>
    </view>
  </view>
</view>
